DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# WhatsApp Cloud API (webhook + outgoing replies)
WHATSAPP_VERIFY_TOKEN=choose-your-own-verification-string
WHATSAPP_ACCESS_TOKEN=permanent-or-temporary-access-token
WHATSAPP_PHONE_NUMBER_ID=phone-number-id-from-meta-dashboard
WHATSAPP_API_VERSION=v22.0

# The MVP serves a single business; this is its UUID from the
# businesses table (created via ingestion / dashboard).
ASKDUKA_BUSINESS_ID=00000000-0000-0000-0000-000000000000

# Claude API (generation — Member 4)
ANTHROPIC_API_KEY=sk-ant-...
